---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers } = await supabase
  .from('providers')
  .select('*')
  .order('category', { ascending: true });

// Get unique categories for the filter buttons
const categories = [...new Set(providers?.map(p => p.category))];
---

<Layout title="Community Help Directory">
	<main class="max-w-2xl mx-auto p-4 md:p-10 font-sans">
		
		<!-- Header -->
		<header class="mb-8 flex justify-between items-start">
			<div>
				<h1 class="text-3xl font-black text-slate-900 tracking-tight">RBD Harmony Help</h1>
				<p class="text-slate-500 mt-1">Verified contacts for our community.</p>
			</div>
			<a 
				href="mailto:lihkinksnikhil@gmail.com?subject=Request to Add New Contact&body=Please add the following contact:%0D%0AName:%0D%0ACategory:%0D%0APhone:" 
				class="bg-blue-50 text-blue-600 px-4 py-2 rounded-full text-sm font-bold hover:bg-blue-100 transition"
			>
				+ Request Add
			</a>
		</header>

		<!-- Search Bar -->
		<div class="sticky top-4 z-10 mb-6">
			<input 
				type="text" 
				id="searchInput"
				placeholder="Search by name or work (e.g. Plumber)..." 
				class="w-full p-4 rounded-2xl border-0 shadow-lg ring-1 ring-slate-200 focus:ring-2 focus:ring-blue-500 outline-none text-lg transition-all"
			/>
		</div>

		<!-- Category Filters -->
		<div class="flex flex-wrap gap-2 mb-8" id="filterContainer">
			<button class="filter-btn active bg-slate-900 text-white px-4 py-1.5 rounded-full text-sm font-medium transition-all" data-category="all">All</button>
			{categories.map(cat => (
				<button class="filter-btn bg-white border border-slate-200 text-slate-600 px-4 py-1.5 rounded-full text-sm font-medium hover:border-blue-300 transition-all" data-category={cat}>{cat}</button>
			))}
		</div>

		<!-- Contacts Grid -->
		<div class="grid gap-4" id="contactsGrid">
			{providers?.map((person) => (
				<div class="contact-card border border-slate-200 rounded-3xl p-5 bg-white shadow-sm flex justify-between items-center transition-all duration-200" 
					 data-name={person.name.toLowerCase()} 
					 data-category={person.category}>
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-1">
							<h2 class="text-xl font-bold text-slate-800">{person.name}</h2>
							{person.is_verified && <span class="bg-blue-100 text-blue-700 text-[10px] uppercase px-2 py-0.5 rounded-full font-bold">Verified</span>}
						</div>
						<div class="flex items-center gap-3">
							<p class="text-blue-600 font-bold text-xs uppercase tracking-widest">{person.category}</p>
							<span class="text-amber-500 font-bold text-sm">⭐ {person.rating}</span>
						</div>
						<div class="flex flex-wrap gap-2 mt-3">
							{person.languages.map((lang: string) => (
								<span class="text-[10px] bg-slate-50 text-slate-500 px-2 py-1 rounded font-medium border border-slate-100">{lang}</span>
							))}
						</div>
					</div>
					
					<a href={`tel:${person.phone}`} class="bg-green-500 hover:bg-green-600 text-white p-4 rounded-2xl transition-all shadow-md active:scale-95 flex items-center gap-2 font-bold ml-4">
						<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
						<span class="hidden md:inline">Call</span>
					</a>
				</div>
			))}
		</div>

		<!-- Footer -->
		<footer class="mt-20 text-center text-slate-400 text-xs">
			<p>Built for RBD Harmony Community • 2026</p>
		</footer>
	</main>
</Layout>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const filterBtns = document.querySelectorAll('.filter-btn');
	const cards = document.querySelectorAll('.contact-card') as NodeListOf<HTMLElement>;

	function filterContacts() {
		const searchTerm = searchInput.value.toLowerCase();
		const activeCategory = document.querySelector('.filter-btn.active')?.getAttribute('data-category');

		cards.forEach(card => {
			const name = card.getAttribute('data-name') || '';
			const category = card.getAttribute('data-category') || '';
			
			const matchesSearch = name.includes(searchTerm) || category.toLowerCase().includes(searchTerm);
			const matchesCategory = activeCategory === 'all' || activeCategory === category;

			if (matchesSearch && matchesCategory) {
				card.style.display = 'flex';
			} else {
				card.style.display = 'none';
			}
		});
	}

	searchInput?.addEventListener('input', filterContacts);

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			filterBtns.forEach(b => b.classList.remove('active', 'bg-slate-900', 'text-white'));
			btn.classList.add('active', 'bg-slate-900', 'text-white');
			filterContacts();
		});
	});
</script>

<style is:global>
	body { background-color: #fdfdfd; }
	.active { pointer-events: none; }
</style>
