---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers } = await supabase
  .from('providers')
  .select('*')
  .order('name', { ascending: true });

// 1. Dynamic Extraction of All Unique Categories & Languages
const allCategories = [...new Set(providers?.flatMap(p => p.categories || []))].filter(Boolean).sort();
const allLanguages = [...new Set(providers?.flatMap(p => p.languages || []))].filter(Boolean).sort();

// 2. Statistics Calculation Logic
const total = providers?.length || 0;

// Calculate counts for every Category
const categoryStats = allCategories.map(cat => ({
	name: cat,
	count: providers?.filter(p => p.categories?.includes(cat)).length || 0,
	per: total > 0 ? ((providers?.filter(p => p.categories?.includes(cat)).length || 0) / total) * 100 : 0
}));

// Calculate counts for every Language
const languageStats = allLanguages.map(lang => ({
	name: lang,
	count: providers?.filter(p => p.languages?.includes(lang)).length || 0,
	per: total > 0 ? ((providers?.filter(p => p.languages?.includes(lang)).length || 0) / total) * 100 : 0
}));

// Gender Logic
const femaleCount = providers?.filter(p => p.gender?.toLowerCase() === 'female').length || 0;
const maleCount = providers?.filter(p => p.gender?.toLowerCase() === 'male').length || 0;
const femalePer = (femaleCount + maleCount) > 0 ? (femaleCount / (femaleCount + maleCount)) * 100 : 0;
---

<Layout title="RDB Harmony | Secure Directory">
	
	<!-- Background Aura -->
	<div class="fixed inset-0 pointer-events-none overflow-hidden z-0 opacity-40">
		<div class="absolute top-[-10%] -left-[10%] w-[40%] h-[40%] bg-orange-600/10 blur-[120px] rounded-full"></div>
		<div class="absolute bottom-[-10%] -right-[10%] w-[40%] h-[40%] bg-blue-600/10 blur-[120px] rounded-full"></div>
		<div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 30px 30px;"></div>
	</div>

	<!-- Hero Header -->
	<div class="relative h-[22vh] min-h-[200px] flex items-center justify-center overflow-hidden bg-zinc-950">
		<img src="/community.jpg" class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale" alt="RDB Harmony" />
		<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>
		<div class="relative z-10 text-center px-4">
			<h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter uppercase italic text-center drop-shadow-2xl">RDB HARMONY</h1>
			<p class="text-orange-500 font-bold tracking-[0.4em] text-[10px] mt-2 uppercase text-center font-sans">The Community Directory</p>
		</div>
	</div>

	<div class="max-w-[1600px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 px-4 lg:px-10 -mt-8 relative z-20 pb-20 font-sans">
		
		<!-- LEFT SIDEBAR: Full Workforce Mix -->
		<aside class="hidden lg:block lg:col-span-3 sticky top-10 self-start space-y-6">
			<div class="bg-zinc-900/50 border border-white/5 rounded-[2rem] p-8 backdrop-blur-xl">
				<div class="flex justify-between items-baseline mb-8">
					<p class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em]">Workforce Mix</p>
					<span class="text-2xl font-black text-white">{total}</span>
				</div>
				
				<div class="space-y-6">
					{categoryStats.map(stat => (
						<div class="space-y-2">
							<div class="flex justify-between items-end">
								<p class="text-[9px] font-black text-zinc-400 uppercase tracking-widest">{stat.name}</p>
								<p class="text-sm font-black text-orange-500">{stat.count}</p>
							</div>
							<div class="h-1 w-full bg-zinc-800 rounded-full overflow-hidden">
								<div class="h-full bg-orange-500 shadow-[0_0_8px_#f97316]" style={`width: ${stat.per}%`}></div>
							</div>
						</div>
					))}
				</div>
			</div>
		</aside>

		<!-- CENTER: Search & Results -->
		<main class="lg:col-span-6 space-y-6">
			<!-- Action Bar -->
			<div class="grid grid-cols-2 gap-3">
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RDB%20Harmony%20-%20Add" class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-5 rounded-3xl hover:border-orange-500/50 transition-all active:scale-95 shadow-xl">
					<span class="text-orange-500 mb-1 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
					<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">Add Contact</span>
				</a>
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RDB%20Harmony%20-%20Remove" class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-5 rounded-3xl hover:border-red-500/50 transition-all active:scale-95 shadow-xl">
					<span class="text-zinc-600 mb-1 group-hover:text-red-500 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
					<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">Remove Contact</span>
				</a>
			</div>

			<!-- Search -->
			<div class="bg-zinc-900/90 backdrop-blur-xl p-1 rounded-3xl shadow-2xl ring-1 ring-white/10 flex items-center">
				<div class="pl-5 text-zinc-600"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></div>
				<input type="text" id="searchInput" placeholder="Search roles, names or keywords..." class="w-full p-5 bg-transparent border-none outline-none text-white placeholder-zinc-700 font-medium text-lg" />
			</div>

			<!-- Filters -->
			<div class="space-y-4">
				<div id="categoryFilters" class="flex gap-2 overflow-x-auto no-scrollbar py-1">
					<button class="filter-btn category-btn active bg-orange-600 text-white px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="category" data-value="all">All Roles</button>
					{allCategories.map(cat => (<button class="filter-btn category-btn bg-zinc-900 border border-zinc-800 text-zinc-500 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0 hover:text-white" data-type="category" data-value={cat}>{cat}</button>))}
				</div>
				<div id="languageFilters" class="flex gap-2 overflow-x-auto no-scrollbar py-1">
					<button class="filter-btn language-btn active bg-blue-600 text-white px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="language" data-value="all">All Langs</button>
					{allLanguages.map(lang => (<button class="filter-btn language-btn bg-zinc-900 border border-zinc-800 text-zinc-500 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0 hover:text-white" data-type="language" data-value={lang}>{lang}</button>))}
				</div>
				<div class="flex gap-2 items-center">
					<div id="genderFilters" class="flex gap-2">
						<button class="filter-btn gender-btn active bg-white text-black px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="all">All Genders</button>
						<button class="filter-btn gender-btn bg-zinc-900 border border-zinc-800 text-zinc-500 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="male">Male</button>
						<button class="filter-btn gender-btn bg-zinc-900 border border-zinc-800 text-zinc-500 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="female">Female</button>
					</div>
					<div class="flex-1"></div>
					<button id="resetBtn" class="bg-zinc-900 border border-zinc-800 text-zinc-500 px-5 py-2 rounded-full text-[10px] font-black uppercase hover:text-red-500 transition-all">Reset</button>
				</div>
			</div>

			<!-- Result Cards -->
			<div class="grid gap-4" id="contactsGrid">
				{providers?.map((person) => (
					<div class="contact-card group bg-zinc-900/60 border border-white/5 rounded-[2.5rem] p-8 flex justify-between items-center transition-all duration-500 hover:bg-zinc-900 hover:border-orange-500/30 shadow-sm" 
						 data-id={person.id} data-name={person.name.toLowerCase()} data-categories={person.categories?.join(',')} data-languages={person.languages?.join(',')}
						 data-gender={person.gender?.toLowerCase() || ''} data-description={person.description?.toLowerCase() || ''} data-date={person.created_at}>
						<div class="flex-1 pr-4">
							<div class="flex items-center gap-3 mb-2">
								<h2 class="text-xl font-bold text-white tracking-tight uppercase italic leading-none">{person.name}</h2>
								<div class="flex gap-1.5 items-center">
									{person.gender && <span class="text-[8px] font-black px-2 py-0.5 rounded bg-zinc-950 text-zinc-600 border border-zinc-800 uppercase tracking-tighter">{person.gender}</span>}
									{person.is_verified && <div class="text-blue-500 bg-blue-500/10 p-1 rounded-full border border-blue-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>}
								</div>
							</div>
							<div class="flex flex-wrap gap-2 mb-4">
								{person.categories?.map((cat: string) => (<span class="text-orange-500/70 font-black text-[9px] uppercase tracking-widest border-b border-orange-500/10">{cat}</span>))}
							</div>
							{person.description && <p class="text-zinc-500 text-xs mb-5 leading-relaxed font-medium">{person.description}</p>}
							<div class="flex gap-4">{person.languages?.map((lang: string) => (<span class="text-[9px] text-zinc-700 font-bold uppercase tracking-widest">{lang}</span>))}</div>
						</div>
						<a href={`tel:${person.phone}`} class="bg-blue-600 hover:bg-orange-600 text-white p-6 rounded-[2rem] shadow-2xl shadow-blue-900/10 transition-all active:scale-90"><svg xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></a>
					</div>
				))}
			</div>
		</main>

		<!-- RIGHT SIDEBAR: Gender & Languages -->
		<aside class="hidden lg:block lg:col-span-3 sticky top-10 self-start space-y-6">
			<div class="bg-zinc-900/50 border border-white/5 rounded-[2rem] p-8 backdrop-blur-xl">
				<p class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em] mb-8">Demographics</p>
				
				<div class="space-y-10">
					<!-- Gender Split Bar -->
					<div class="space-y-3">
						<div class="flex justify-between items-end">
							<p class="text-[10px] font-black text-white uppercase tracking-widest">Gender Split</p>
							<div class="flex gap-2 items-baseline">
								<span class="text-xs font-black text-zinc-500">M {maleCount}</span>
								<span class="text-xs font-black text-orange-500">F {femaleCount}</span>
							</div>
						</div>
						<div class="h-1.5 w-full bg-zinc-800 rounded-full overflow-hidden flex">
							<div class="h-full bg-zinc-200" style={`width: ${100 - femalePer}%`}></div>
							<div class="h-full bg-orange-500 shadow-[0_0_8px_#f97316]" style={`width: ${femalePer}%`}></div>
						</div>
					</div>

					<!-- Language Distribution -->
					<div class="space-y-6 pt-6 border-t border-white/5">
						<p class="text-[10px] font-black text-zinc-500 uppercase tracking-widest">Language Fluency</p>
						{languageStats.map(stat => (
							<div class="space-y-2">
								<div class="flex justify-between items-end">
									<p class="text-[9px] font-black text-zinc-400 uppercase tracking-widest">{stat.name}</p>
									<p class="text-sm font-black text-blue-500">{stat.count}</p>
								</div>
								<div class="h-1 w-full bg-zinc-800 rounded-full overflow-hidden">
									<div class="h-full bg-blue-500 shadow-[0_0_8px_#3b82f6]" style={`width: ${stat.per}%`}></div>
								</div>
							</div>
						))}
					</div>
				</div>
			</div>
		</aside>

	</div>
</Layout>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const resetBtn = document.getElementById('resetBtn');
	const filterBtns = document.querySelectorAll('.filter-btn');
	const grid = document.getElementById('contactsGrid');
	const cards = Array.from(document.querySelectorAll('.contact-card')) as HTMLElement[];

	const themes = {
		category: ['bg-orange-600', 'text-white', 'border-transparent', 'active'],
		language: ['bg-blue-600', 'text-white', 'border-transparent', 'active'],
		gender: ['bg-white', 'text-black', 'border-transparent', 'active'],
		inactive: ['bg-zinc-900', 'text-zinc-500', 'border-zinc-800']
	};

	function applyFilters() {
		const searchTerm = searchInput.value.toLowerCase();
		const activeCats = Array.from(document.querySelectorAll('.category-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');
		const activeLangs = Array.from(document.querySelectorAll('.language-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');
		const activeGenders = Array.from(document.querySelectorAll('.gender-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');

		cards.forEach(card => {
			const name = card.getAttribute('data-name') || '', cats = card.getAttribute('data-categories')?.split(',') || [], langs = card.getAttribute('data-languages')?.split(',') || [], gender = card.getAttribute('data-gender') || '', desc = card.getAttribute('data-description') || '';
			const matchSearch = name.includes(searchTerm) || cats.some(c => c.toLowerCase().includes(searchTerm)) || desc.includes(searchTerm);
			const matchCat = activeCats.length === 0 || cats.some(c => activeCats.includes(c));
			const matchLang = activeLangs.length === 0 || langs.some(l => activeLangs.includes(l));
			const matchGender = activeGenders.length === 0 || activeGenders.includes(gender);
			card.style.display = (matchSearch && matchCat && matchLang && matchGender) ? 'flex' : 'none';
		});
	}

	resetBtn?.addEventListener('click', () => {
		searchInput.value = '';
		filterBtns.forEach(btn => {
			const type = btn.getAttribute('data-type') as keyof typeof themes, isAll = btn.getAttribute('data-value') === 'all';
			btn.classList.remove(...(themes[type] || []), ...themes.inactive);
			if (isAll) btn.classList.add(...(themes[type] || []), 'active'); else btn.classList.add(...themes.inactive);
		});
		applyFilters();
	});

	searchInput?.addEventListener('input', applyFilters);
	
	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type') as keyof typeof themes, val = btn.getAttribute('data-value'), allBtn = document.querySelector(`.${type}-btn[data-value="all"]`), group = document.querySelectorAll(`.${type}-btn`);
			if (val === 'all') {
				group.forEach(b => { b.classList.remove(...themes[type], 'active'); b.classList.add(...themes.inactive); });
				btn.classList.add(...themes[type], 'active'); btn.classList.remove(...themes.inactive);
			} else {
				btn.classList.toggle('active');
				if (btn.classList.contains('active')) {
					btn.classList.add(...themes[type]); btn.classList.remove(...themes.inactive);
					allBtn?.classList.remove(...themes[type], 'active'); allBtn?.classList.add(...themes.inactive);
				} else {
					btn.classList.remove(...themes[type]); btn.classList.add(...themes.inactive);
				}
				if (!document.querySelector(`.${type}-btn.active`)) {
					allBtn?.classList.add(...themes[type], 'active'); allBtn?.classList.remove(...themes.inactive);
				}
			}
			applyFilters();
		});
	});
</script>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
	body { background-color: #09090b; font-family: 'Inter', sans-serif; color-scheme: dark; overflow-x: hidden; }
	.no-scrollbar::-webkit-scrollbar { display: none; }
	.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
