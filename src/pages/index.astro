---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers } = await supabase
  .from('providers')
  .select('*')
  .order('name', { ascending: true });

const allCategories = [...new Set(providers?.flatMap(p => p.categories || []))].filter(Boolean).sort();
const allLanguages = [...new Set(providers?.flatMap(p => p.languages || []))].filter(Boolean).sort();

// Data for side display
const verifiedCount = providers?.filter(p => p.is_verified).length || 0;
const totalHelpers = providers?.length || 0;
---

<Layout title="RBD Harmony | Secure Directory">
	
	<!-- Background Decorative Aura (Desktop Only) -->
	<div class="fixed inset-0 pointer-events-none overflow-hidden z-0 opacity-40">
		<div class="absolute top-[-10%] -left-[10%] w-[40%] h-[40%] bg-orange-600/10 blur-[120px] rounded-full"></div>
		<div class="absolute bottom-[-10%] -right-[10%] w-[40%] h-[40%] bg-blue-600/10 blur-[120px] rounded-full"></div>
		<div class="absolute inset-0" style="background-image: radial-gradient(rgba(255,255,255,0.03) 1px, transparent 1px); background-size: 30px 30px;"></div>
	</div>

	<!-- Hero Header -->
	<div class="relative h-[25vh] min-h-[220px] flex items-center justify-center overflow-hidden bg-zinc-950">
		<img src="/community.jpg" class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale" alt="RBD Harmony" />
		<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>
		<div class="relative z-10 text-center px-4">
			<h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter uppercase italic text-center drop-shadow-2xl">RBD HARMONY</h1>
			<p class="text-orange-500 font-bold tracking-[0.4em] text-[10px] mt-2 uppercase text-center font-sans">Gated Community Directory</p>
		</div>
	</div>

	<!-- Main Layout -->
	<div class="max-w-[1400px] mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8 px-4 lg:px-8 -mt-8 relative z-20 pb-20 font-sans">
		
		<!-- LEFT SIDEBAR: Stats -->
		<aside class="hidden lg:block lg:col-span-3 sticky top-6 self-start">
			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-8 backdrop-blur-md">
				<p class="text-[10px] font-black text-zinc-500 uppercase tracking-[0.2em] mb-6">Database Stats</p>
				<div class="space-y-6">
					<div>
						<p class="text-4xl font-black text-white leading-none">{totalHelpers}</p>
						<p class="text-[10px] text-zinc-500 uppercase font-bold tracking-widest mt-2">Active Contacts</p>
					</div>
					<div class="pt-6 border-t border-white/5">
						<p class="text-4xl font-black text-blue-500 leading-none">{verifiedCount}</p>
						<p class="text-[10px] text-zinc-500 uppercase font-bold tracking-widest mt-2">Verified Pros</p>
					</div>
				</div>
			</div>
		</aside>

		<!-- CENTER: Main Interaction Area -->
		<main class="lg:col-span-6 space-y-6">
			
			<!-- Management Action Bar -->
			<div class="grid grid-cols-2 gap-3">
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RBD%20Harmony%20-%20Add%20Contact&body=Please%20add:%0D%0AName:%0D%0AGender:%0D%0APhone:%0D%0ACategories:%0D%0ALanguages:%0D%0ADescribe%20in%20what%20he/she%20is%20good%20at:" class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-4 rounded-2xl hover:border-orange-500/50 transition-all active:scale-95 shadow-xl">
					<span class="text-orange-500 mb-1 group-hover:scale-110 transition-transform"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
					<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest text-center">Add Contact</span>
				</a>
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RBD%20Harmony%20-%20Remove%20Contact" class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-4 rounded-2xl hover:border-red-500/50 transition-all active:scale-95 shadow-xl">
					<span class="text-zinc-600 mb-1 group-hover:text-red-500 transition-colors"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg></span>
					<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest text-center">Remove Contact</span>
				</a>
			</div>

			<!-- Search -->
			<div class="bg-zinc-900/90 backdrop-blur-xl p-1.5 rounded-3xl shadow-2xl ring-1 ring-white/10 flex items-center">
				<div class="pl-4 text-zinc-500"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg></div>
				<input type="text" id="searchInput" placeholder="Search roles, names, keywords..." class="w-full p-4 bg-transparent border-none outline-none text-white placeholder-zinc-600 font-medium" />
			</div>

			<!-- Filters Group -->
			<div class="space-y-4">
				<div id="categoryFilters" class="flex gap-2 overflow-x-auto no-scrollbar py-1">
					<button class="filter-btn category-btn active bg-orange-600 text-white px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="category" data-value="all">All Work</button>
					{allCategories.map(cat => (
						<button class="filter-btn category-btn bg-zinc-900 border border-zinc-800 text-zinc-400 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0 hover:text-white" data-type="category" data-value={cat}>{cat}</button>
					))}
				</div>
				<div id="languageFilters" class="flex gap-2 overflow-x-auto no-scrollbar py-1">
					<button class="filter-btn language-btn active bg-blue-600 text-white px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="language" data-value="all">All Languages</button>
					{allLanguages.map(lang => (
						<button class="filter-btn language-btn bg-zinc-900 border border-zinc-800 text-zinc-400 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0 hover:text-white" data-type="language" data-value={lang}>{lang}</button>
					))}
				</div>
				<div id="genderFilters" class="flex gap-2">
					<button class="filter-btn gender-btn active bg-white text-black px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="all">All Genders</button>
					<button class="filter-btn gender-btn bg-zinc-900 border border-zinc-800 text-zinc-400 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="male">Male</button>
					<button class="filter-btn gender-btn bg-zinc-900 border border-zinc-800 text-zinc-400 px-5 py-2 rounded-full text-[10px] font-black uppercase shrink-0" data-type="gender" data-value="female">Female</button>
				</div>
				<div class="flex gap-2">
					<select id="sortSelect" class="flex-1 bg-zinc-900 text-zinc-400 text-[10px] font-black uppercase tracking-widest border border-zinc-800 rounded-2xl px-4 py-3 outline-none focus:ring-1 focus:ring-orange-500 transition-all cursor-pointer">
						<option value="name-asc">Sort: A-Z</option>
						<option value="name-desc">Sort: Z-A</option>
						<option value="newest">Recently Added</option>
					</select>
					<button id="resetBtn" class="bg-zinc-900 border border-zinc-800 text-zinc-500 px-8 py-3 rounded-2xl text-[10px] font-black uppercase hover:text-white transition-all active:scale-95">Reset</button>
				</div>
			</div>

			<!-- Grid List -->
			<div class="grid gap-4" id="contactsGrid">
				{providers?.map((person) => (
					<div class="contact-card group bg-zinc-900 border border-white/5 rounded-[2rem] p-7 flex justify-between items-center transition-all duration-300 hover:bg-zinc-800/40 hover:border-orange-500/30 shadow-sm" 
						 data-id={person.id} data-name={person.name.toLowerCase()} data-categories={person.categories?.join(',')} data-languages={person.languages?.join(',')}
						 data-gender={person.gender?.toLowerCase() || ''} data-description={person.description?.toLowerCase() || ''} data-date={person.created_at}>
						<div class="flex-1 pr-4">
							<div class="flex items-center gap-3 mb-2">
								<h2 class="text-xl font-bold text-white tracking-tight uppercase italic leading-none">{person.name}</h2>
								<div class="flex gap-1.5 items-center">
									{person.gender && <span class="text-[8px] font-black px-1.5 py-0.5 rounded bg-zinc-950 text-zinc-500 border border-zinc-800 uppercase tracking-tighter">{person.gender}</span>}
									{person.is_verified && <div class="text-blue-500 bg-blue-500/10 p-1 rounded-full border border-blue-500/20"><svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg></div>}
								</div>
							</div>
							<div class="flex flex-wrap gap-2 mb-3">
								{person.categories?.map((cat: string) => (<span class="text-orange-500/70 font-black text-[9px] uppercase tracking-widest border-b border-orange-500/20">{cat}</span>))}
							</div>
							{person.description && <p class="text-zinc-500 text-xs mb-4 leading-relaxed font-medium">{person.description}</p>}
							<div class="flex gap-4">{person.languages?.map((lang: string) => (<span class="text-[9px] text-zinc-700 font-bold uppercase tracking-widest">{lang}</span>))}</div>
						</div>
						<a href={`tel:${person.phone}`} class="bg-blue-600 hover:bg-orange-600 text-white p-6 rounded-2xl transition-all active:scale-90"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg></a>
					</div>
				))}
			</div>
		</main>

		<!-- RIGHT SIDEBAR: Community Focus (Visible on Desktop) -->
		<aside class="hidden lg:block lg:col-span-3 sticky top-6 self-start">
			<div class="bg-zinc-900/50 border border-white/5 rounded-3xl p-8 backdrop-blur-md text-center">
				<div class="w-12 h-12 bg-orange-500/10 rounded-2xl flex items-center justify-center mx-auto mb-4 border border-orange-500/20">
					<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-orange-500"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
				</div>
				<p class="text-[10px] font-black text-zinc-300 uppercase tracking-[0.2em] mb-2">Community Led</p>
				<p class="text-xs text-zinc-500 leading-relaxed">This directory is updated by neighbors for neighbors. All data is securely handled.</p>
			</div>
		</aside>

	</div>

	<footer class="mt-20 py-10 text-center opacity-40">
		<p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.6em]">RBD Harmony • Community Access</p>
	</footer>
</Layout>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement;
	const resetBtn = document.getElementById('resetBtn');
	const filterBtns = document.querySelectorAll('.filter-btn');
	const grid = document.getElementById('contactsGrid');
	const cards = Array.from(document.querySelectorAll('.contact-card')) as HTMLElement[];

	const themes = {
		category: ['bg-orange-600', 'text-white', 'border-transparent', 'active'],
		language: ['bg-blue-600', 'text-white', 'border-transparent', 'active'],
		gender: ['bg-white', 'text-black', 'border-transparent', 'active'],
		inactive: ['bg-zinc-900', 'text-zinc-400', 'border-zinc-800']
	};

	function applyFilters() {
		const searchTerm = searchInput.value.toLowerCase();
		const sortBy = sortSelect.value;
		
		const activeCats = Array.from(document.querySelectorAll('.category-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');
		const activeLangs = Array.from(document.querySelectorAll('.language-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');
		const activeGenders = Array.from(document.querySelectorAll('.gender-btn.active')).map(b => b.getAttribute('data-value')).filter(v => v !== 'all');

		const visibleCards = cards.filter(card => {
			const name = card.getAttribute('data-name') || '', cats = card.getAttribute('data-categories')?.split(',') || [], langs = card.getAttribute('data-languages')?.split(',') || [], gender = card.getAttribute('data-gender') || '', desc = card.getAttribute('data-description') || '';
			const matchSearch = name.includes(searchTerm) || cats.some(c => c.toLowerCase().includes(searchTerm)) || desc.includes(searchTerm);
			const matchCat = activeCats.length === 0 || cats.some(c => activeCats.includes(c)), matchLang = activeLangs.length === 0 || langs.some(l => activeLangs.includes(l)), matchGender = activeGenders.length === 0 || activeGenders.includes(gender);
			const isVisible = matchSearch && matchCat && matchLang && matchGender;
			card.style.display = isVisible ? 'flex' : 'none';
			return isVisible;
		});

		visibleCards.sort((a, b) => {
			const nameA = a.getAttribute('data-name')!, nameB = b.getAttribute('data-name')!;
			if (sortBy === 'name-asc') return nameA.localeCompare(nameB);
			if (sortBy === 'name-desc') return nameB.localeCompare(nameA);
			if (sortBy === 'newest') return new Date(b.getAttribute('data-date')!).getTime() - new Date(a.getAttribute('data-date')!).getTime();
			return 0;
		});
		visibleCards.forEach(card => grid?.appendChild(card));
	}

	resetBtn?.addEventListener('click', () => {
		searchInput.value = ''; sortSelect.value = 'name-asc';
		filterBtns.forEach(btn => {
			const type = btn.getAttribute('data-type') as keyof typeof themes, isAll = btn.getAttribute('data-value') === 'all';
			btn.classList.remove(...(themes[type] || []), ...themes.inactive);
			if (isAll) btn.classList.add(...(themes[type] || []), 'active'); else btn.classList.add(...themes.inactive);
		});
		applyFilters();
	});

	searchInput?.addEventListener('input', applyFilters);
	sortSelect?.addEventListener('change', applyFilters);
	
	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const type = btn.getAttribute('data-type') as keyof typeof themes, val = btn.getAttribute('data-value'), allBtn = document.querySelector(`.${type}-btn[data-value="all"]`), group = document.querySelectorAll(`.${type}-btn`);
			if (val === 'all') {
				group.forEach(b => { b.classList.remove(...themes[type], 'active'); b.classList.add(...themes.inactive); });
				btn.classList.add(...themes[type], 'active'); btn.classList.remove(...themes.inactive);
			} else {
				btn.classList.toggle('active');
				if (btn.classList.contains('active')) {
					btn.classList.add(...themes[type]); btn.classList.remove(...themes.inactive);
					allBtn?.classList.remove(...themes[type], 'active'); allBtn?.classList.add(...themes.inactive);
				} else {
					btn.classList.remove(...themes[type]); btn.classList.add(...themes.inactive);
				}
				if (!document.querySelector(`.${type}-btn.active`)) {
					allBtn?.classList.add(...themes[type], 'active'); allBtn?.classList.remove(...themes.inactive);
				}
			}
			applyFilters();
		});
	});
</script>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
	body { background-color: #09090b; font-family: 'Inter', sans-serif; color-scheme: dark; overflow-x: hidden; }
	.no-scrollbar::-webkit-scrollbar { display: none; }
	.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
