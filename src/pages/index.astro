---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers } = await supabase
  .from('providers')
  .select('*')
  .order('name', { ascending: true });

const allCategories = [...new Set(providers?.flatMap(p => p.categories || []))]
  .filter(cat => cat && cat.trim() !== '')
  .sort();
---

<Layout title="RBD Harmony | Secure Directory">
	<!-- Hero Header -->
	<div class="relative h-[25vh] min-h-[220px] flex items-center justify-center overflow-hidden bg-zinc-950">
		<img src="/community.jpg" class="absolute inset-0 w-full h-full object-cover opacity-20 grayscale" alt="RBD Harmony" />
		<div class="absolute inset-0 bg-gradient-to-t from-zinc-950 via-zinc-950/40 to-transparent"></div>
		<div class="relative z-10 text-center px-4">
			<h1 class="text-5xl md:text-7xl font-black text-white tracking-tighter uppercase italic text-center text-shadow-lg">RBD HARMONY</h1>
			<p class="text-orange-500 font-bold tracking-[0.4em] text-[10px] mt-2 uppercase text-center">Gated Community Directory</p>
		</div>
	</div>

	<main class="max-w-2xl mx-auto px-4 -mt-8 relative z-20 pb-20 font-sans">
		
		<!-- Management Action Bar -->
		<div class="grid grid-cols-2 gap-3 mb-8">
			<a 
				href="mailto:lihkinksnikhil@gmail.com?subject=RBD%20Harmony%20-%20Add%20Contact&body=Please%20add:%0D%0AName:%0D%0APhone:%0D%0ACategories:" 
				class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-4 rounded-2xl hover:border-orange-500/50 transition-all active:scale-95 shadow-xl"
			>
				<span class="text-orange-500 mb-1 group-hover:scale-110 transition-transform">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
				</span>
				<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">Add Contact</span>
			</a>
			<a 
				href="mailto:lihkinksnikhil@gmail.com?subject=RBD%20Harmony%20-%20Remove%20Contact&body=Please%20remove:%0D%0AName:" 
				class="group flex flex-col items-center justify-center bg-zinc-900 border border-zinc-800 p-4 rounded-2xl hover:border-red-500/50 transition-all active:scale-95 shadow-xl"
			>
				<span class="text-zinc-600 mb-1 group-hover:text-red-500 transition-colors">
					<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line></svg>
				</span>
				<span class="text-[10px] font-black text-zinc-400 uppercase tracking-widest">Remove Contact</span>
			</a>
		</div>

		<!-- Search Bar with Examples -->
		<div class="bg-zinc-900/90 backdrop-blur-xl p-1.5 rounded-3xl shadow-2xl ring-1 ring-white/10 flex items-center mb-6">
			<div class="pl-4 text-zinc-500">
				<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
			</div>
			<input 
				type="text" 
				id="searchInput" 
				placeholder="Search roles or names... (e.g. Plumber, Maid, Ramesh)" 
				class="w-full p-4 bg-transparent border-none outline-none text-white placeholder-zinc-600 font-medium" 
			/>
		</div>

		<!-- Filter & Sort Row -->
		<div class="flex flex-col md:flex-row justify-between items-center px-1 gap-4 mb-8">
			<div class="flex gap-2 overflow-x-auto no-scrollbar py-2 w-full md:w-auto" id="filterContainer">
				<button class="filter-btn active bg-orange-600 text-white px-5 py-2 rounded-full text-[10px] font-black uppercase tracking-widest transition-all shrink-0 shadow-lg shadow-orange-950/40 border border-transparent" data-category="all">All</button>
				{allCategories.map(cat => (
					<button class="filter-btn bg-zinc-900 border border-zinc-800 text-zinc-400 px-5 py-2 rounded-full text-[10px] font-black uppercase tracking-widest hover:text-white transition-all shrink-0" data-category={cat}>{cat}</button>
				))}
			</div>
			
			<select id="sortSelect" class="w-full md:w-auto bg-zinc-900 text-zinc-400 text-[10px] font-black uppercase tracking-widest border border-zinc-800 rounded-2xl px-4 py-3 outline-none focus:ring-1 focus:ring-orange-500 transition-all cursor-pointer">
				<option value="name-asc">Sort: A-Z</option>
				<option value="name-desc">Sort: Z-A</option>
				<option value="newest">Recently Added</option>
			</select>
		</div>

		<!-- Contacts Grid -->
		<div class="grid gap-4" id="contactsGrid">
			{providers?.map((person) => (
				<div class="contact-card group bg-zinc-900 border border-white/5 rounded-[2rem] p-7 flex justify-between items-center transition-all duration-300 hover:bg-zinc-800/40 hover:border-orange-500/30 shadow-sm" 
					 data-id={person.id}
					 data-name={person.name.toLowerCase()} 
					 data-categories={person.categories?.join(',')}
					 data-date={person.created_at}>
					
					<div class="flex-1">
						<div class="flex items-center gap-3 mb-2">
							<h2 class="text-xl font-bold text-white tracking-tight group-hover:text-orange-500 transition-colors uppercase italic">{person.name}</h2>
							{person.is_verified && (
								<div class="text-blue-500 bg-blue-500/10 p-1 rounded-full border border-blue-500/20 shadow-[0_0_10px_rgba(59,130,246,0.2)]">
									<svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
								</div>
							)}
						</div>
						
						<div class="flex flex-wrap gap-2 mb-4">
							{person.categories?.map((cat: string) => (
								<span class="text-orange-500/70 font-black text-[9px] uppercase tracking-widest border-b border-orange-500/20">{cat}</span>
							))}
						</div>

						<div class="flex gap-4">
							{person.languages?.map((lang: string) => (
								<span class="text-[9px] text-zinc-700 font-bold uppercase tracking-widest">{lang}</span>
							))}
						</div>
					</div>
					
					<a href={`tel:${person.phone}`} class="bg-blue-600 hover:bg-orange-600 text-white p-6 rounded-2xl shadow-2xl shadow-blue-900/20 transition-all active:scale-90 hover:shadow-orange-950/20">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
					</a>
				</div>
			))}
		</div>

		<footer class="mt-20 py-10 text-center border-t border-white/5 opacity-40">
			<p class="text-zinc-600 text-[9px] font-black uppercase tracking-[0.6em]">RBD Harmony • Community Access</p>
		</footer>
	</main>
</Layout>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const sortSelect = document.getElementById('sortSelect') as HTMLSelectElement;
	const filterBtns = document.querySelectorAll('.filter-btn');
	const grid = document.getElementById('contactsGrid');
	const cards = Array.from(document.querySelectorAll('.contact-card')) as HTMLElement[];

	const activeClasses = ['bg-orange-600', 'text-white', 'border-transparent', 'active', 'shadow-lg', 'shadow-orange-950/40'];
	const inactiveClasses = ['bg-zinc-900', 'text-zinc-400', 'border-zinc-800'];

	function applySearchFilterSort() {
		const searchTerm = searchInput.value.toLowerCase();
		const sortBy = sortSelect.value;
		
		const activeCategories = Array.from(document.querySelectorAll('.filter-btn.active'))
			.map(btn => btn.getAttribute('data-category'))
			.filter(cat => cat !== 'all');

		const visibleCards = cards.filter(card => {
			const name = card.getAttribute('data-name') || '';
			const categories = card.getAttribute('data-categories')?.split(',') || [];
			const matchesSearch = name.includes(searchTerm) || categories.some(c => c.toLowerCase().includes(searchTerm));
			const matchesCategory = activeCategories.length === 0 || categories.some(cat => activeCategories.includes(cat));
			const isVisible = matchesSearch && matchesCategory;
			card.style.display = isVisible ? 'flex' : 'none';
			return isVisible;
		});

		visibleCards.sort((a, b) => {
			const nameA = a.getAttribute('data-name')!;
			const nameB = b.getAttribute('data-name')!;
			if (sortBy === 'name-asc') return nameA.localeCompare(nameB);
			if (sortBy === 'name-desc') return nameB.localeCompare(nameA);
			if (sortBy === 'newest') return new Date(b.getAttribute('data-date')!).getTime() - new Date(a.getAttribute('data-date')!).getTime();
			return 0;
		});

		visibleCards.forEach(card => grid?.appendChild(card));
	}

	searchInput?.addEventListener('input', applySearchFilterSort);
	sortSelect?.addEventListener('change', applySearchFilterSort);
	
	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			const category = btn.getAttribute('data-category');
			const allBtn = document.querySelector('.filter-btn[data-category="all"]');

			if (category === 'all') {
				filterBtns.forEach(b => {
					b.classList.remove(...activeClasses);
					b.classList.add(...inactiveClasses);
				});
				btn.classList.add(...activeClasses);
				btn.classList.remove(...inactiveClasses);
			} else {
				btn.classList.toggle('active');
				if (btn.classList.contains('active')) {
					btn.classList.add(...activeClasses);
					btn.classList.remove(...inactiveClasses);
					allBtn?.classList.remove(...activeClasses);
					allBtn?.classList.add(...inactiveClasses);
				} else {
					btn.classList.remove(...activeClasses);
					btn.classList.add(...inactiveClasses);
				}
				const anyActive = document.querySelectorAll('.filter-btn.active').length > 0;
				if (!anyActive) {
					allBtn?.classList.add(...activeClasses);
					allBtn?.classList.remove(...inactiveClasses);
				}
			}
			applySearchFilterSort();
		});
	});
</script>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
	body { 
		background-color: #09090b; 
		font-family: 'Inter', sans-serif;
		color-scheme: dark;
	}
	.no-scrollbar::-webkit-scrollbar { display: none; }
</style>
