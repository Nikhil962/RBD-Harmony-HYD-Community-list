---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

const { data: providers } = await supabase
  .from('providers')
  .select('*')
  .order('name', { ascending: true });

const allCategories = [...new Set(providers?.flatMap(p => p.categories || []))]
  .filter(cat => cat && cat.trim() !== '')
  .sort();
---

<Layout title="RBD Harmony | Community Directory">
	<!-- Hero Section -->
	<div class="relative h-[40vh] min-h-[300px] flex items-center justify-center overflow-hidden">
		<img 
			src="/community.jpg" 
			class="absolute inset-0 w-full h-full object-cover"
			alt="RBD Harmony"
		/>
		<div class="absolute inset-0 bg-gradient-to-t from-slate-900 via-slate-900/40 to-transparent"></div>
		
		<div class="relative z-10 text-center px-4">
			<h1 class="text-4xl md:text-5xl font-black text-white tracking-tight drop-shadow-lg">RBD HARMONY</h1>
			<p class="text-orange-400 font-bold tracking-[0.2em] text-sm mt-2 uppercase drop-shadow-md">Verified Help Directory</p>
			
			<!-- Desktop Action Buttons -->
			<div class="hidden md:flex gap-3 justify-center mt-6">
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RBD Harmony - Add New&body=Name:" class="bg-orange-500 hover:bg-orange-600 text-white px-6 py-2 rounded-full font-bold text-sm transition-all shadow-lg">+ Add New</a>
				<a href="mailto:lihkinksnikhil@gmail.com?subject=RBD Harmony - Remove&body=Name:" class="bg-white/20 hover:bg-white/30 backdrop-blur-md text-white px-6 py-2 rounded-full font-bold text-sm transition-all border border-white/30">- Remove</a>
			</div>
		</div>
	</div>

	<main class="max-w-2xl mx-auto px-4 -mt-12 relative z-20 pb-20">
		
		<!-- Glassmorphism Search Bar -->
		<div class="bg-white/80 backdrop-blur-xl p-2 rounded-3xl shadow-2xl ring-1 ring-black/5 mb-8">
			<input 
				type="text" 
				id="searchInput"
				placeholder="Search for a plumber, maid, electrician..." 
				class="w-full p-4 rounded-2xl bg-transparent border-none outline-none text-lg text-slate-800 placeholder-slate-400"
			/>
		</div>

		<!-- Category Filter (Pills) -->
		<div class="flex gap-2 overflow-x-auto pb-4 no-scrollbar mb-6" id="filterContainer">
			<button class="filter-btn active bg-orange-500 text-white px-6 py-2 rounded-full text-xs font-black uppercase tracking-widest transition-all shrink-0 shadow-orange-200 shadow-lg" data-category="all">All</button>
			{allCategories.map(cat => (
				<button class="filter-btn bg-white border border-slate-200 text-slate-500 px-6 py-2 rounded-full text-xs font-black uppercase tracking-widest hover:border-orange-300 transition-all shrink-0" data-category={cat}>{cat}</button>
			))}
		</div>

		<!-- Mobile Action Buttons -->
		<div class="flex md:hidden gap-2 mb-8">
			<a href="mailto:..." class="flex-1 bg-slate-900 text-white p-3 rounded-2xl text-center text-xs font-bold uppercase tracking-widest">+ Add</a>
			<a href="mailto:..." class="flex-1 bg-slate-100 text-slate-600 p-3 rounded-2xl text-center text-xs font-bold uppercase tracking-widest">- Remove</a>
		</div>

		<!-- Contacts List -->
		<div class="grid gap-4" id="contactsGrid">
			{providers?.map((person) => (
				<div class="contact-card group bg-white border border-slate-100 rounded-[2rem] p-6 flex justify-between items-center shadow-sm hover:shadow-xl hover:border-orange-200 transition-all duration-300" 
					 data-name={person.name.toLowerCase()} 
					 data-categories={person.categories.join(',')}>
					<div class="flex-1">
						<div class="flex items-center gap-2 mb-1">
							<h2 class="text-xl font-bold text-slate-800 group-hover:text-orange-600 transition-colors">{person.name}</h2>
							{person.is_verified && <span class="text-blue-500 text-sm">●</span>}
						</div>
						
						<div class="flex flex-wrap gap-1.5 mb-4">
							{person.categories.map((cat: string) => (
								<span class="text-orange-500 font-black text-[9px] uppercase tracking-widest">
									{cat}
								</span>
							))}
						</div>

						<div class="flex items-center gap-4">
							<div class="bg-orange-50 px-2 py-1 rounded-lg">
								<span class="text-orange-600 font-bold text-xs">⭐ {person.rating}</span>
							</div>
							<div class="flex gap-2">
								{person.languages.map((lang: string) => (
									<span class="text-[9px] text-slate-400 font-bold uppercase border-b border-slate-200">{lang}</span>
								))}
							</div>
						</div>
					</div>
					
					<a href={`tel:${person.phone}`} class="bg-blue-500 hover:bg-orange-500 text-white p-5 rounded-[1.5rem] transition-all shadow-lg shadow-blue-100 hover:shadow-orange-100 active:scale-90">
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
					</a>
				</div>
			))}
		</div>

		<p class="mt-12 text-center text-slate-400 text-[10px] font-bold uppercase tracking-[0.3em]">
			Engineered for RBD Harmony Residents
		</p>
	</main>
</Layout>

<script>
	const searchInput = document.getElementById('searchInput') as HTMLInputElement;
	const filterBtns = document.querySelectorAll('.filter-btn');
	const cards = document.querySelectorAll('.contact-card') as NodeListOf<HTMLElement>;

	const activeClasses = ['bg-orange-500', 'text-white', 'shadow-orange-200', 'shadow-lg', 'active', 'border-transparent'];
	const inactiveClasses = ['bg-white', 'text-slate-500', 'border-slate-200'];

	function performFilter() {
		const searchTerm = searchInput.value.toLowerCase();
		const activeBtn = document.querySelector('.filter-btn.active');
		const activeCategory = activeBtn?.getAttribute('data-category');

		cards.forEach(card => {
			const name = card.getAttribute('data-name') || '';
			const categories = card.getAttribute('data-categories')?.split(',') || [];
			const matchesSearch = name.includes(searchTerm) || categories.some(c => c.toLowerCase().includes(searchTerm));
			const matchesCategory = activeCategory === 'all' || categories.includes(activeCategory);
			card.style.display = (matchesSearch && matchesCategory) ? 'flex' : 'none';
		});
	}

	searchInput?.addEventListener('input', performFilter);

	filterBtns.forEach(btn => {
		btn.addEventListener('click', () => {
			filterBtns.forEach(b => {
				b.classList.remove(...activeClasses);
				b.classList.add(...inactiveClasses);
			});
			btn.classList.remove(...inactiveClasses);
			btn.classList.add(...activeClasses);
			performFilter();
		});
	});
</script>

<style is:global>
	@import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;700;900&display=swap');
	body { 
		background-color: #f8fafc;
		font-family: 'Inter', sans-serif;
	}
	.no-scrollbar::-webkit-scrollbar { display: none; }
	.no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
</style>
